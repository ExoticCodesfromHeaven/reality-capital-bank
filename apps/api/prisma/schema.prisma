// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum UserStatus {
  EMAIL_PENDING
  KYC_PENDING
  ACTIVE
  SUSPENDED
  FROZEN
  REJECTED
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountType {
  CHECKING
  SAVINGS
  BUSINESS
  JOINT
  INVESTMENT
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionCategory {
  TRANSFER
  INTERNATIONAL_TRANSFER
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  FIXED_DEPOSIT
  INTEREST
  CHARGE
  REVERSAL
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  WAITING_FOR_CUSTOMER
  WAITING_FOR_SUPPORT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  WITHDRAWN
  CANCELLED
}

enum JointInvestmentStatus {
  PENDING
  ACTIVE
  MATURED
  WITHDRAWN
  CANCELLED
}

enum ParticipantStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
}

enum FixedDepositStatus {
  ACTIVE
  MATURED
  WITHDRAWN
  CANCELLED
}

enum InternationalTransferStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum TransferPriority {
  STANDARD
  EXPRESS
}

enum MessageSender {
  CUSTOMER
  ADMIN
  SYSTEM
}

// =========================
// ROLE MANAGEMENT
// =========================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model SystemSetting {
  id String @id @default(uuid())

  key String @unique

  value Json

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// BANKING
// =========================

model Currency {
  id String @id @default(uuid())

  code   String @unique
  name   String
  symbol String

  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  isActive Boolean @default(true)

  countries Country[]
  accounts  Account[]

  internationalSenderTransfers InternationalTransfer[] @relation("InternationalSenderCurrency")

internationalReceiverTransfers InternationalTransfer[] @relation("InternationalReceiverCurrency")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id String @id @default(uuid())

  name      String
  isoCode   String  @unique
  phoneCode String
  flagEmoji String?

  isActive Boolean @default(true)

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  firstName  String
  middleName String?
  lastName   String

  username String @unique

  email String  @unique
  phone String? @unique

  password String

  avatar String?

  dateOfBirth DateTime?

  emailVerified Boolean @default(false)

  status UserStatus @default(EMAIL_PENDING)

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  accounts      Account[]
  otps          OTP[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]

  beneficiaries Beneficiary[]

  kyc KYC?

  approvedTransfers Transfer[] @relation("ApprovedTransfers")

  approvedInternationalTransfers InternationalTransfer[] @relation("ApprovedInternationalTransfers")

  investments Investment[]

  fixedDeposits FixedDeposit[]

  supportTickets SupportTicket[]

  assignedTickets SupportTicket[] @relation("AssignedTickets")

  supportMessages SupportMessage[]

  createdJointInvestments JointInvestment[] @relation("CreatedJointInvestments")

  jointInvestmentParticipants JointInvestmentParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
}

model Account {
  id String @id @default(uuid())

  accountNumber String @unique

  accountName String

  balance Decimal @default(0) @db.Decimal(18, 2)

  availableBalance Decimal @default(0) @db.Decimal(18, 2)

  accountType AccountType

  status AccountStatus @default(ACTIVE)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  fixedDeposits FixedDeposit[]

  sentTransfers Transfer[] @relation("SenderTransfers")

  receivedTransfers Transfer[] @relation("ReceiverTransfers")

  investments Investment[]

  transactions Transaction[]

  internationalTransfers InternationalTransfer[]

  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  JointInvestmentParticipant JointInvestmentParticipant[]

  @@index([accountNumber])
}

model KYC {
  id String @id @default(uuid())

  status KYCStatus @default(PENDING)

  idDocument      String
  addressDocument String?
  selfie          String?

  rejectionReason String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Transaction {
  id String @id @default(uuid())

  reference String @unique

  type TransactionType

  category TransactionCategory

  status TransactionStatus @default(PENDING)

  amount Decimal @db.Decimal(18, 2)

  balanceBefore Decimal @db.Decimal(18, 2)

  balanceAfter Decimal @db.Decimal(18, 2)

  narration String?

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  internationalTransferId String?

  internationalTransfer InternationalTransfer? @relation(fields: [internationalTransferId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reference])
  @@index([accountId])
  @@index([transferId])
}

model Transfer {
  id String @id @default(uuid())

  reference String @unique

  amount Decimal @db.Decimal(18, 2)

  narration String?

  status TransferStatus @default(PENDING)

  senderAccountId String
  senderAccount   Account @relation("SenderTransfers", fields: [senderAccountId], references: [id])

  receiverAccountId String
  receiverAccount   Account @relation("ReceiverTransfers", fields: [receiverAccountId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedTransfers", fields: [approvedById], references: [id])

  approvedAt DateTime?

  rejectionReason String?

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([senderAccountId])
  @@index([receiverAccountId])
}

model InternationalTransfer {
  id String @id @default(uuid())

  reference String @unique

  amount Decimal @db.Decimal(18,2)

  fee Decimal @db.Decimal(18,2)

  exchangeRate Decimal @db.Decimal(18,6)

  convertedAmount Decimal @db.Decimal(18,2)

  senderCurrencyId String
  senderCurrency Currency @relation("InternationalSenderCurrency", fields: [senderCurrencyId], references: [id])


  receiverCurrencyId String
  receiverCurrency Currency @relation("InternationalReceiverCurrency", fields: [receiverCurrencyId], references: [id])

  recipientName String

  recipientAccountNumber String

  recipientBankName String

  recipientBankAddress String?

  recipientCountry String

  swiftCode String

  iban String?

  routingNumber String?

  purpose String

  priority TransferPriority @default(STANDARD)

  status InternationalTransferStatus @default(PENDING)

  rejectionReason String?

  approvedAt DateTime?

  completedAt DateTime?

  senderAccountId String
  senderAccount Account @relation( fields: [senderAccountId], references: [id])

  approvedById String?

  approvedBy User? @relation("ApprovedInternationalTransfers", fields: [approvedById], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([senderAccountId])
}

model Investment {
  id String @id @default(uuid())

  amount Decimal @db.Decimal(18, 2)

  interestRate Decimal @db.Decimal(5, 2)

  expectedReturn Decimal @db.Decimal(18, 2)

  totalAtMaturity Decimal @db.Decimal(18, 2)

  durationMonths Int

  status InvestmentStatus @default(ACTIVE)

  startsAt DateTime @default(now())

  maturesAt DateTime

  withdrawnAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String

  account Account @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model JointInvestment {
  id String @id @default(uuid())

  name String?

  amount Decimal @db.Decimal(18, 2)

  interestRate Decimal @db.Decimal(5, 2)

  expectedReturn Decimal @db.Decimal(18, 2)

  totalAtMaturity Decimal @db.Decimal(18, 2)

  durationMonths Int

  status JointInvestmentStatus @default(PENDING)

  startsAt DateTime?

  maturesAt DateTime?

  createdById String

  createdBy User @relation("CreatedJointInvestments", fields: [createdById], references: [id])

  participants JointInvestmentParticipant[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model JointInvestmentParticipant {
  id String @id @default(uuid())

  contribution Decimal @db.Decimal(18, 2)

  ownership Decimal @db.Decimal(5, 2)

  status ParticipantStatus @default(PENDING)

  jointInvestmentId String

  jointInvestment JointInvestment @relation(fields: [jointInvestmentId], references: [id], onDelete: Cascade)

  userId String

  accountId String

  account Account @relation(fields: [accountId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jointInvestmentId, userId])
}

model FixedDepositPlan {

  id String @id @default(uuid())


  name String


  durationMonths Int


  interestRate Decimal @db.Decimal(5,2)


  minimumAmount Decimal @db.Decimal(18,2)


  maximumAmount Decimal? @db.Decimal(18,2)


  isActive Boolean @default(true)


  deposits FixedDeposit[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model FixedDeposit {

  id String @id @default(uuid())


  amount Decimal @db.Decimal(18,2)


  interestRate Decimal @db.Decimal(5,2)


  expectedInterest Decimal @db.Decimal(18,2)


  maturityAmount Decimal @db.Decimal(18,2)


  startsAt DateTime


  maturesAt DateTime


  status FixedDepositStatus @default(ACTIVE)


  userId String

  user User @relation (fields:[userId], references:[id])


  accountId String

  account Account @relation (fields:[accountId], references:[id])


  planId String

  plan FixedDepositPlan @relation ( fields:[planId], references:[id])


  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt

}

model Beneficiary {
  id String @id @default(uuid())

  nickname String?

  accountNumber String

  accountName String

  bankName String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model OTP {
  id String @id @default(uuid())

  code String

  type OTPType

  expiresAt DateTime

  used Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(uuid())

  refreshToken String @unique

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id String @id @default(uuid())

  ticketNumber String @unique

  subject String

  category String

  priority TicketPriority @default(MEDIUM)

  status TicketStatus @default(OPEN)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  messages SupportMessage[]

  lastMessageAt DateTime?

  closedAt DateTime?

  customerUnread Int @default(0)

  adminUnread Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

model SupportMessage {

  id String @id @default(uuid())

  message String

  attachmentUrl String?

  attachmentName String?

  attachmentType String?

  isRead Boolean @default(false)

  edited Boolean @default(false)

  editedAt DateTime?

  isSystemMessage Boolean @default(false)

  isAdmin Boolean @default(false)

  ticketId String

  ticket SupportTicket @relation(fields:[ticketId], references:[id], onDelete:Cascade)

  senderId String

  senderType MessageSender

  sender User @relation(fields:[senderId], references:[id])

  createdAt DateTime @default(now())

  @@index([ticketId])

}

model AuditLog {
  id String @id @default(uuid())

  action String

  description String?

  ipAddress String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
}
